/dts-v1/;

#include "qcs8550-retroidpocket-rp6.dts"

/ {
	model = "Retroid Pocket Nova";
	compatible = "retroidpocket,rpnova", "qcom,qcs8550", "qcom,sm8550";
};

&backlight {
	status = "disabled";
};

&mdss_dsi0 {
	panel@0 {
		compatible = "il97680a,rpnova";
		steamling,dpu-8bpc-dither;
		/delete-property/ backlight;
		/delete-property/ rotation;
		/*
		 * The Nova's own rails, as Android and Retroid's tree have them.
		 * The RP6 node supplies vddio and avdd, but the il97680a driver
		 * asks for vdd, vddio, vci, vdd18 and vdd28: avdd went unused,
		 * and the 2.8 V and 1.2 V rails stayed as the bootloader left
		 * them, on through every blank and suspend.
		 */
		/delete-property/ avdd-supply;
		vdd-supply = <&vreg_l11b_1p2>;
		vddio-supply = <&vreg_l12b_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vdd18-supply = <&vdd_disp_1v8>;
		vdd28-supply = <&vdd_disp_2v8>;
	};
};

/* GPIO 142 is the RP6's; Android's qcom,platform-mipi-2v8 is 143. */
&vdd_disp_2v8 {
	gpio = <&tlmm 143 GPIO_ACTIVE_HIGH>;
};

&i2c_hub_3 {
	touchscreen@38 {
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
		/delete-property/ touchscreen-inverted-y;
	};
};

&gamepad {
	invert-x;
	invert-y;
	trigger-left-deadzone = <100>;
	trigger-right-deadzone = <100>;
};
