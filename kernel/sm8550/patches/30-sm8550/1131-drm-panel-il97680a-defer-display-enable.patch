From: Raxcoms <mpaulo968@gmail.com>
Subject: [PATCH] drm/panel: il97680a: defer display enable

Keep the Pocket Nova panel dark until the DRM enable step restores the
cached brightness.

[steamling: armada 0109 (armada-os/armada 0f7bfc0), rebased onto 1130.
The brightness in .enable goes out high byte first, as
il97680a_bl_update_status() sends it with
mipi_dsi_dcs_set_display_brightness_large(): the plain
mipi_dsi_dcs_set_display_brightness_multi() armada used sends the low
byte first, so a level of 0x0bb8 reached the panel as 0xb80b and the
panel lit near full brightness at every enable. 1130's page 0x22 E1
write moves with display on, which Android sends it after.]
---
--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -112,26 +112,18 @@
 
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
 				     0x20);
+	/*
+	 * Dark until .enable, which sets the backlight's brightness before
+	 * display on: Android's 0x0d75 here lit the panel at a fixed level
+	 * first, whatever the backlight was set to.
+	 */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
-				     0x0d, 0x75, 0x00, 0x00);
+				     0x00, 0x00, 0x00, 0x00);
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
 
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
-
-	mipi_dsi_msleep(&dsi_ctx, 20);
-
-	/*
-	 * Android's on-command ends with register E1 of page 0x22 set to 1,
-	 * after display on; Retroid's driver sends it too. Neither says what
-	 * it controls. Back to page 0x00 for the brightness writes.
-	 */
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x22);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x01);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
-
 	return dsi_ctx.accum_err;
 }
 
@@ -211,6 +203,32 @@
 	return 0;
 }
 
+static int il97680a_enable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	u16 level = drm_panel_bl_levels_map(&pinfo->bl_levels,
+					    pinfo->panel.backlight ?
+					    backlight_get_brightness(pinfo->panel.backlight) : 0);
+	/* High byte first, as il97680a_bl_update_status() sends it. */
+	u8 brightness[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 8, level & 0xff };
+
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, brightness, sizeof(brightness));
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	/*
+	 * Android's on-command ends with register E1 of page 0x22 set to 1,
+	 * after display on; Retroid's driver sends it too. Neither says what
+	 * it controls. Back to page 0x00 for the brightness writes.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x22);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+
+	return dsi_ctx.accum_err;
+}
+
 static int il97680a_disable(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
@@ -290,6 +308,7 @@
 
 static const struct drm_panel_funcs il97680a_panel_funcs = {
 	.disable = il97680a_disable,
+	.enable = il97680a_enable,
 	.prepare = il97680a_prepare,
 	.unprepare = il97680a_unprepare,
 	.get_modes = il97680a_get_modes,
