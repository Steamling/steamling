From: David J. Vandenburgh <david@vandenburgh.co>
Subject: [PATCH] drm/panel: vtdr6130 (RP6): keep sysfs commands off a panel
 that is off, and never black it out from the slider

The brightness and frame-length attributes send DSI commands from process
context with nothing ordering them against enable/disable. The brightness
path also sent them while the panel was off, and read the level back over
DSI on every actual_brightness read; a failed read returned early with the
host left out of low-power mode. A write racing a modeset (the boot-time
calibration restore against the first gamescope commit, a brightness change
during a session switch) could clear LPM in the middle of the init sequence
or address a powered-down panel.

Guard enabled and every sysfs-driven command sequence with a mutex, skip the
brightness write while the panel is off (drm_panel_enable() re-applies the
cached level through backlight_enable()), restore LPM on every path, and
report actual_brightness from the backlight core instead of a DSI read.
The same shape as armada's icna35xx serialisation (0518a).

Also floor a screen-on brightness at 40 of 4095, the bottom of Steam's own
slider on this panel (dim but readable, measured on an RP6): a desktop slider
or a script writing 0 left the panel on and fully black.
---
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -33,6 +34,13 @@
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	/*
+	 * Serialises the DSI commands sent from sysfs (brightness, frame length)
+	 * against enable/disable, and guards enabled. Without it a write racing a
+	 * modeset could flip the host out of low-power mode in the middle of the
+	 * init sequence, or reach a panel that is already powered down.
+	 */
+	struct mutex lock;
 	bool enabled;
 
 	u16 frame_len_120;
@@ -309,7 +317,9 @@
 {
 	struct panel_info *pinfo = to_panel_info(panel);
 
+	mutex_lock(&pinfo->lock);
 	pinfo->enabled = true;
+	mutex_unlock(&pinfo->lock);
 
 	return 0;
 }
@@ -319,7 +329,9 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	mutex_lock(&pinfo->lock);
 	pinfo->enabled = false;
+	mutex_unlock(&pinfo->lock);
 
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
@@ -402,43 +414,48 @@
 	.get_orientation = vtdr6130_get_orientation,
 };
 
+/*
+ * The lowest level a screen-on write may set. 0 turns the OLED fully black with
+ * the panel still on, and only a blind slider drag gets it back; Steam's own
+ * slider stops at 40, which is dim but readable, so nothing else goes lower.
+ */
+#define VTDR6130_MIN_BRIGHTNESS	40
+
 static int vtdr6130_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* Blanking (backlight_disable() on the way off) still writes 0. */
+	if (!backlight_is_blank(bl))
+		brightness = max_t(u16, brightness, VTDR6130_MIN_BRIGHTNESS);
 
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	guard(mutex)(&pinfo->lock);
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
-}
-
-static int vtdr6130_bl_get_brightness(struct backlight_device *bl)
-{
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
+	/*
+	 * A panel that is off takes no commands. The level is kept by the
+	 * backlight core, and drm_panel_enable() re-applies it through
+	 * backlight_enable() once the panel is back on.
+	 */
+	if (!pinfo->enabled)
+		return 0;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
-
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return brightness;
+	return ret < 0 ? ret : 0;
 }
 
+/*
+ * No get_brightness: the panel only ever shows the level written last, so
+ * actual_brightness reports that from the core instead of a DSI read, which
+ * failed with the panel off and then left the host out of low-power mode.
+ */
 static const struct backlight_ops vtdr6130_bl_ops = {
 	.update_status = vtdr6130_bl_update_status,
-	.get_brightness = vtdr6130_bl_get_brightness,
 };
 
 static struct backlight_device *vtdr6130_create_backlight(struct mipi_dsi_device *dsi)
@@ -470,6 +487,8 @@
 	if (val < min || val > max)
 		return -EINVAL;
 
+	guard(mutex)(&pinfo->lock);
+
 	*frame_len = val;
 
 	if (!pinfo->enabled)
@@ -542,6 +561,10 @@
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
 	panel_supplies, &pinfo->supplies);
 	if (ret < 0){
