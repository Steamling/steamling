# Per-SoC kernel config deltas: scripts/config arguments, applied after build-kernel.sh's own
# set and before olddefconfig. make sync leaves this file alone.

# Display blocks SM8550 does not have: it drives its DSI panel and DP through the DPU, with the
# 7nm-family DSI PHY (its 4nm variant lives in that driver). MDP4/MDP5, HDMI and the older DSI
# PHY generations are other SoCs'.
--disable DRM_MSM_MDP4
--disable DRM_MSM_MDP5
--disable DRM_MSM_HDMI
--disable DRM_MSM_HDMI_HDCP
--disable DRM_MSM_DSI_28NM_PHY
--disable DRM_MSM_DSI_20NM_PHY
--disable DRM_MSM_DSI_28NM_8960_PHY
--disable DRM_MSM_DSI_14NM_PHY
--disable DRM_MSM_DSI_10NM_PHY

# CPU: every SM8550 board has eight cores. 512 also makes arm64 select CPUMASK_OFFSTACK, which allocates
# every cpumask_var_t on the heap; at 8 they are one word on the stack.
--set-val NR_CPUS 8
