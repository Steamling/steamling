From 9f9eb662a4fe163a7ea3885db55b4bc8beb78330 Mon Sep 17 00:00:00 2001
From: Aaron N <aaronna@valvesoftware.com>
Date: Sun, 26 Jul 2026 19:21:35 -0700
Subject: [PATCH] wifi: ath12k: complete regd_update_completed on dropped reg
 events

ath12k_reg_chan_list_event() only assigns pdev_idx after
ath12k_reg_validate_reg_info() returns VALID, so DROP & FALLBACK
replies reach the out: with pdev_idx still 255 and complete_all()
is skipped. Every country command arms the completion first so a
dropped reply orphans the completion and the next ath12k_regd_update()
stalls for a 3 second timeout (which logs a "Timeout while waiting
for regulatory update").

With dynamic user hints enabled this happens on module reload (including
resuming from sleep). Cfg80211 replays the user hint during registration,
the deferred hint is sent from ath12k_mac_hw_register() after arming the
completion and the firmware's reply is dropped by the default-regd dedup
in ath12k_reg_validate_reg_info(). The subsequent 6 GHz regd rebuild
then times out.

The fix is to record the phy id as soon as the event parses so the
drop paths can still resolve the ar and signal the waiter.
---
 drivers/net/wireless/ath/ath12k/wmi.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index d8b802d60766..66d51fa955fb 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -7764,6 +7764,11 @@ static int ath12k_reg_chan_list_event(struct ath12k_base *ab, struct sk_buff *sk
 		goto mem_free;
 	}
 
+	/* Assign before validation so DROP/FALLBACK exits still complete
+	 * the regd_update waiter.
+	 */
+	pdev_idx = reg_info->phy_id;
+
 	ret = ath12k_reg_validate_reg_info(ab, reg_info);
 	if (ret == ATH12K_REG_STATUS_FALLBACK) {
 		ath12k_warn(ab, "failed to validate reg info %d\n", ret);
@@ -7780,7 +7785,6 @@ static int ath12k_reg_chan_list_event(struct ath12k_base *ab, struct sk_buff *sk
 	}
 
 	/* free old reg_info if it exist */
-	pdev_idx = reg_info->phy_id;
 	if (ab->reg_info[pdev_idx]) {
 		ath12k_reg_reset_reg_info(ab->reg_info[pdev_idx]);
 		kfree(ab->reg_info[pdev_idx]);
@@ -7818,8 +7822,10 @@ fallback:
 	WARN_ON(1);
 
 out:
-	/* In some error cases, even a valid pdev_idx might not be available */
-	if (pdev_idx != 255)
+	/* pdev_idx is unvalidated or still 255 if the
+	 * event never parsed
+	 */
+	if (pdev_idx < ab->num_radios)
 		ar = ab->pdevs[pdev_idx].ar;
 
 	/* During the boot-time update, 'ar' might not be allocated,
-- 
