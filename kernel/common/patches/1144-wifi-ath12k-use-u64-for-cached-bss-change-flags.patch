From a498f595a7b0a68d5e55848ae9b9d8701c8bc813 Mon Sep 17 00:00:00 2001
From: Aaron N <aaronna@valvesoftware.com>
Date: Fri, 19 Jun 2026 20:18:39 -0700
Subject: [PATCH] wifi: ath12k: use u64 for cached BSS change flags

mac80211 passes BSS change notifications to link_info_changed() as a
u64 mask. ath12k caches that mask for links whose vdev has not been
created yet and replays it once the vdev is assigned.

Keep the cached mask as u64 as well. A u32 cache truncates flags above
bit 31, such as BSS_CHANGED_TPE, so those deferred updates can be lost
before ath12k_mac_bss_info_changed() gets a chance to process them.
---
 drivers/net/wireless/ath/ath12k/core.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index 1494d2b9069f..a752da9ed064 100644
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -300,7 +300,7 @@ struct ath12k_key_conf {
 struct ath12k_vif_cache {
 	struct ath12k_tx_conf tx_conf;
 	struct ath12k_key_conf key_conf;
-	u32 bss_conf_changed;
+	u64 bss_conf_changed;
 };
 
 struct ath12k_rekey_data {
-- 
2.34.1

