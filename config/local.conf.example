# Your own Steamling build settings. Copy this file to config/local.conf and fill it in:
#
#   cp config/local.conf.example config/local.conf
#
# config/local.conf is never committed (it can hold your Wi-Fi password), and every build reads it
# before config/steamling.conf, so whatever you set here wins. Leave a line commented out to keep
# Steamling's default. It's read by bash, so no spaces around the "=". Then build as usual:
#
#   ./build.sh            (or: make image)

# --- Which handheld family to build for ---------------------------------------------------------
# sm8550 covers the Retroid Pocket 6, Pocket Nova, AYN Odin 2 and the other Snapdragon 8 Gen 2
# handhelds (docs/devices.md lists them all).
DEVICE=sm8550

# --- Which base to build from ---------------------------------------------------------------------
# The base is everything that comes from Arch Linux ARM rather than from Steamling.
#   live   Build straight from Arch Linux ARM: its latest rootfs tarball and its own package repos.
#          Nothing is frozen, uploaded or synced, and every build gets whatever ALARM has that day.
#          Handhelds built this way stay on live ALARM when they update.
#   (unset) The frozen snapshot config/steamling.conf pins, so every build gets the same versions.
STEAMLING_BASE_SNAPSHOT=live
# The rootfs tarball a build starts from. This is already the default; change it only to use a
# mirror or a specific dated tarball.
#STEAMLING_ALARM_TARBALL_URL=http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz

# --- Build speed ----------------------------------------------------------------------------------
# ccache keeps compiled objects between builds, so rebuilding a package only recompiles what
# changed. 20G is plenty for every package; the kernel keeps its own cache.
STEAMLING_CCACHE=on
STEAMLING_CCACHE_SIZE=20G

# --- First boot of the SD image -------------------------------------------------------------------
# The default password is "root", which everyone knows: pick your own for images you'll keep.
#SD_ROOT_PASSWORD=root
# SSH on from the first boot (handy while testing; turn it off for images you hand to others).
#SD_SSH=on
# Join Wi-Fi on first boot. The country code (US, GB, DE...) is needed for 5 GHz networks.
#SD_WIFI_SSID=MyNetwork
#SD_WIFI_PSK=MyPassword
#SD_WIFI_COUNTRY=US
# The handheld's timezone (a name from /usr/share/zoneinfo). UTC if unset.
#SD_TIMEZONE=America/New_York

# --- Only if you host things yourself -------------------------------------------------------------
# None of this is needed to build. It's for hosting your own frozen base, a package repo for
# over-the-air updates, or image downloads (docs/building/own-base.md).
#STEAMLING_BASE_RCLONE_REMOTE=r2:steamling/repo/base
#STEAMLING_BASE_URL=https://pub-REPLACE-ME.r2.dev/repo/base
#STEAMLING_REPO_RCLONE_REMOTE=r2:steamling/repo
#STEAMLING_REPO_URL=https://pub-REPLACE-ME.r2.dev/repo
#STEAMLING_REPO_GPG_KEY=you@example.com
#STEAMLING_REPO_PUBKEY=config/steamling-repo.asc
#STEAMLING_IMAGE_RCLONE_REMOTE=r2:steamling/images
#STEAMLING_IMAGE_URL=https://pub-REPLACE-ME.r2.dev/images
