From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Tue, 20 Oct 2026 12:19:40 +0200
Subject: [PATCH] tu/a6xx: Set correct value for GRAS_MODE_CNTL
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Previous value resulted in misrendering/hangs in the following minimal
case on at least Adreno 650:

One instanced draw: DrawInstanced(4, 16384), a triangle strip with no
vertex buffers. The vertex shader builds all geometry from the instance ID:

- Instances repeat in groups of 189.
- In each group, 185 instances are culled and produce zero fragments
  (NaN position; off-screen or degenerate positions work the same).
- The other 4 instances are 32×128 px quads spread over the screen.

The pixel shader outputs a constant colour and writes the sample mask
(SV_Coverage / gl_SampleMask). No depth, color blending enabled.

Or written as D3D11:

- VS:

```
// VS: no vertex buffers. Instances repeat in groups of 189:
// 185 culled (zero coverage), then 4 visible 32x128 px quads at hashed positions.
static const float2 corners[4] = { float2(0, 0), float2(1, 0), float2(0, 1), float2(1, 1) };

float4 main(uint vid : SV_VertexID, uint iid : SV_InstanceID) : SV_Position
{
    float2 c = float2(frac(float((iid * 2654435761u) >> 8) / 16777216.0),
                      frac(float((iid * 2246822519u) >> 8) / 16777216.0)) * 2.0 - 1.0;
    float2 p = c + (corners[vid & 3u] - 0.5) * float2(32.0 / 640.0, 128.0 / 360.0);
    if (iid % 189u < 185u)
        return asfloat(0x7fc00000u).xxxx;       // NaN -> culled
    return float4(p, 0.5, 1.0);
}
```

- FS:
```
// PS: constant colour. The sample-mask write is what makes it hang.
float4 main(float4 pos : SV_Position, out uint mask : SV_Coverage) : SV_Target
{
    mask = 0xffffffff;
    return float4(0.1, 0.1, 0.1, 0.1);
}
```

- Rendering:
```
D3D11_TEXTURE2D_DESC td = {1280, 720, 1, 1, DXGI_FORMAT_R11G11B10_FLOAT, {1, 0},
                           D3D11_USAGE_DEFAULT, D3D11_BIND_RENDER_TARGET};
dev->CreateTexture2D(&td, nullptr, &rt);
dev->CreateRenderTargetView(rt, nullptr, &rtv);

// Premultiplied-alpha blend
D3D11_BLEND_DESC bd = {};
bd.RenderTarget[0].BlendEnable = TRUE;
bd.RenderTarget[0].SrcBlend  = bd.RenderTarget[0].SrcBlendAlpha  = D3D11_BLEND_ONE;
bd.RenderTarget[0].DestBlend = bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_INV_SRC_ALPHA;
bd.RenderTarget[0].BlendOp   = bd.RenderTarget[0].BlendOpAlpha   = D3D11_BLEND_OP_ADD;
bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
dev->CreateBlendState(&bd, &bs);

D3D11_RASTERIZER_DESC rd = {D3D11_FILL_SOLID, D3D11_CULL_NONE};
rd.DepthClipEnable = TRUE;
dev->CreateRasterizerState(&rd, &rs);

const float zero[4] = {};
ctx->ClearRenderTargetView(rtv, zero);

for (int f = 0; f < frames; ++f) {
    ctx->OMSetRenderTargets(1, &rtv, nullptr);              // no depth
    ctx->OMSetBlendState(bs, nullptr, 0xffffffff);
    ctx->RSSetState(rs);
    D3D11_VIEWPORT vp = {0, 0, 1280, 720, 0, 1};
    ctx->RSSetViewports(1, &vp);
    ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);   // no input layout
    ctx->VSSetShader(vs, nullptr, 0);
    ctx->PSSetShader(ps, nullptr, 0);

    ctx->DrawInstanced(4, 16384, 0, 0);     // ~86 groups: ~346 visible quads, ~16000 culled

    ctx->ClearState();
    ctx->CopyResource(sync_dst, sync_src);  // Map() waits: GPU idle between frames
    ctx->Map(sync_dst, 0, D3D11_MAP_READ, 0, &ms);
    ctx->Unmap(sync_dst, 0);
}
```

Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16389
Cc: mesa-stable
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45421>
(cherry picked from commit 761d5c8a54f93b3d43608f718910ed742983dd0b)
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 63ea6055262..97e67922599 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -2201,7 +2201,7 @@ tu6_init_static_regs(struct tu_device *dev, struct tu_cs *cs)
    tu_cs_emit_regs(cs, A6XX_VFD_MODE_CNTL(.vertex = true, .instance = true));
    tu_cs_emit_write_reg(cs, REG_A6XX_RB_MODE_CNTL, 0x00000010);
 
-   tu_cs_emit_regs(cs, GRAS_MODE_CNTL(CHIP, CHIP >= A7XX ? 0x2 : 0));
+   tu_cs_emit_regs(cs, GRAS_MODE_CNTL(CHIP, 0x2));
 
    tu_cs_emit_write_reg(cs, REG_A6XX_RB_UNKNOWN_8818, 0);
 
