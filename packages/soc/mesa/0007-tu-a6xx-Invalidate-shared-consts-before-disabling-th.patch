From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Tue, 20 Oct 2026 16:36:25 +0200
Subject: [PATCH] tu/a6xx: Invalidate shared consts before disabling them

SP_UPDATE_CNTL::GFX_SHARED_CONST (and CS_SHARED_CONST) only has an
effect while HLSQ_SHARED_CONSTS is enabled.

When switching from a pipeline that uses shared consts to one that
doesn't, shared consts were first disabled via HLSQ_SHARED_CONSTS::ENABLE
and only then was SP_UPDATE_CNTL emitted. With shared consts already
disabled, SP_UPDATE_CNTL _presumably_ didn't clear the pending shared
consts load. If there is an event between such draws, the second draw
executes in the same context as the previous one (since an event also
flips the context), and the pending load incorrectly writes the old
shared consts into the const space of the second draw.

Cc: mesa-stable
Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45447>
(cherry picked from commit cadc7e42fb721dca2531df1f80ff381a1d04134d)
---
 src/freedreno/vulkan/tu_pipeline.cc | 12 ++++++++++--
 src/freedreno/vulkan/tu_shader.cc   |  7 ++++---
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 100c32c1e997..e9ec2c11ec5d 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -1353,12 +1353,20 @@ tu6_emit_program_config(struct tu_cs *cs,
 
    bool shared_consts_enable =
       prog->shared_consts.type == IR3_PUSH_CONSTS_SHARED;
-   tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
 
+   /* A6XX: SP_UPDATE_CNTL::GFX_SHARED_CONST only has an effect while HLSQ_SHARED_CONSTS is enabled.
+    * If SP_UPDATE_CNTL is emitted after shared consts are disabled, it _presumably_ doesn't clear
+    * the pending shared consts load of a previous pipeline. If there is an event between the draws,
+    * the second draw executes in the same context as the previous one (an event also flips the
+    * context), and the pending load writes the old shared consts into its const space. So
+    * SP_UPDATE_CNTL must happen before HLSQ_SHARED_CONSTS.
+    */
    crb.add(SP_UPDATE_CNTL(CHIP, .vs_state = true, .hs_state = true,
                           .ds_state = true, .gs_state = true,
                           .fs_state = true, .gfx_uav = true,
-                          .gfx_shared_const = shared_consts_enable));
+                          .gfx_shared_const = CHIP == A6XX));
+
+   tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
 
    const struct ir3_shader_variant *vs = variants[MESA_SHADER_VERTEX];
    const struct ir3_shader_variant *hs = variants[MESA_SHADER_TESS_CTRL];
diff --git a/src/freedreno/vulkan/tu_shader.cc b/src/freedreno/vulkan/tu_shader.cc
index e4a227552695..f6059bc50a0d 100644
--- a/src/freedreno/vulkan/tu_shader.cc
+++ b/src/freedreno/vulkan/tu_shader.cc
@@ -2147,10 +2147,11 @@ tu6_emit_cs_config(struct tu_cs *cs,
       ir3_const_state(v)->push_consts_type == IR3_PUSH_CONSTS_SHARED;
 
    with_crb (cs) {
-      tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
-
+      /* A6XX: SP_UPDATE_CNTL must happen before HLSQ_SHARED_CONSTS(), see tu6_emit_program_config */
       crb.add(SP_UPDATE_CNTL(CHIP, .cs_state = true, .cs_uav = true,
-                             .cs_shared_const = shared_consts_enable));
+                             .cs_shared_const = CHIP == A6XX));
+
+      tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
       tu6_emit_xs_config<CHIP>(crb, { .cs = v });
       tu6_emit_xs<CHIP>(crb, cs->device, MESA_SHADER_COMPUTE, v, pvtmem, binary_iova);
    }
