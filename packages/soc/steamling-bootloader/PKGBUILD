# steamling-bootloader-<soc> — the OpenABL install kit for one chip family. One recipe for every
# SoC, like linux-steamling: build-packages.sh names it from STEAMLING_SOC.
# Boot contract (qcom-abl): XBL -> ABL -> /KERNEL (Android boot image) off any FAT partition.
# The factory ABL boots only Android, so OpenABL must be flashed to abl_a/abl_b ONCE before
# any SD boots. One elf covers every board of a SoC: the release keys it by SoC, not board.
# OpenABL (Open Handheld Collective) replaced the ROCKNIX ABL, whose repo and releases are gone;
# ROCKNIX moved over in October 2026 (README.provenance has the commits). The kit folder keeps its
# old name, rocknix_abl, so backups and docs from the ROCKNIX ABL days still line up.
# Nothing here flashes at build or install time; both flashing paths (the kit by hand from rooted
# Android, steamling-update-abl afterwards) are deliberate user actions.
_soc="${STEAMLING_SOC:?set by build-packages.sh}"
_SOC="${_soc^^}"
pkgname="steamling-bootloader-${_soc}"
_ablver=1.1
# OpenABL restarted the numbering below the ROCKNIX ABL's 1.2
epoch=1
pkgver=${_ablver}
pkgrel=1
pkgdesc="${_SOC} qcom-abl boot payload: OpenABL install kit (rocknix_abl)"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-3.0-or-later' 'BSD-2-Clause-Patent')   # OpenABL (Abl/ part with a linking exception); kit scripts GPL-2.0
source=("https://github.com/OpenHandheldCollective/OpenABL/releases/download/v${_ablver}/openabl-v${_ablver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-steamling-abl-kit.hook')
sha512sums=('edcff09576e3f7c2e0019f526a42df61ddf8ff9867033bbb1ca5c46a71de36b528986df8950c21b5f53e45e3b12a6de9178815b3120f327b49261aae2cc5c2b0'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # the release ships a .sha256 sidecar per elf
  ( cd "openabl-v${_ablver}/${_SOC}" && sha256sum -c "abl_signed-${_SOC}.elf.sha256" )
  sed "s/%DEVICE%/${_SOC}/g" flash_abl.sh.template > flash_abl.sh
  # steamling-update-abl reports the shipped version; the elf itself carries none
  echo "${_ablver}" > version
}

package() {
  local kit="${pkgdir}/usr/share/steamling/bootloader/rocknix_abl"

  install -Dm644 "openabl-v${_ablver}/${_SOC}/abl_signed-${_SOC}.elf" "${kit}/abl_signed-${_SOC}.elf"
  install -Dm644 README                 "${kit}/README"
  install -Dm755 flash_abl.sh           "${kit}/flash_abl.sh"
  install -Dm755 backup_abl.sh          "${kit}/backup_abl.sh"
  install -Dm755 restore_backup_abl.sh  "${kit}/restore_backup_abl.sh"
  install -Dm644 version                "${kit}/version"

  # the GPL wants its text next to the binary; kept out of the kit so the SD copy stays small
  install -Dm644 "openabl-v${_ablver}/LICENSE"    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "openabl-v${_ablver}/LICENSES.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.md"
  cp -r "openabl-v${_ablver}/LICENSES" "${pkgdir}/usr/share/licenses/${pkgname}/"

  # pacman never touches /flash, so a hook re-copies the kit there on upgrade.
  install -Dm644 "${srcdir}/95-steamling-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-steamling-abl-kit.hook"
}
