# Keeps the kit on /flash matching the shipped ABL, so provisioning another device from this card
# uses it. Copies FILES only: never flash the bootloader from a hook.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/steamling/bootloader/openabl/*

[Action]
Description = steamling: refreshing the ABL install kit on /flash (no bootloader is written)...
When = PostTransaction
Exec = /usr/bin/steamling-refresh-abl-kit
