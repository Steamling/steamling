From e6674a98118ca7b098b98a3874b8f195ae1bf750 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Mon, 19 Oct 2026 21:14:42 -0700
Subject: [PATCH] rendervulkan: align upload ring allocations to the uniform
 offset limit

The upload ring aligns every allocation to 16 bytes, but constants are
bound as a uniform buffer at that offset and NVIDIA requires 64. With
eight composite layers BlitPushData_t is 584 bytes, so the RGB to NV12
constants that follow it in vulkan_screenshot land at offset 592. The
convert pass then never writes the NV12 image, and Steam Remote Play
shows a green frame.

Align to minUniformBufferOffsetAlignment, floored at 16 so buffer to
image copies from the same ring keep their texel alignment.

Closes: https://github.com/ValveSoftware/gamescope/issues/2489
---
 src/rendervulkan.cpp | 1 +
 src/rendervulkan.hpp | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index cecf3fc..77134f2 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -537,6 +537,7 @@ bool CVulkanDevice::createDevice()
 		VkPhysicalDeviceProperties deviceProperties;
 		vk.GetPhysicalDeviceProperties( physDev(), &deviceProperties );
 		m_uVendorID = deviceProperties.vendorID;
+		m_uUploadAlignment = std::max<uint32_t>( 16, deviceProperties.limits.minUniformBufferOffsetAlignment );
 	}
 
 	float queuePriorities = 1.0f;
diff --git a/src/rendervulkan.hpp b/src/rendervulkan.hpp
index cd35ecb..3566b3f 100644
--- a/src/rendervulkan.hpp
+++ b/src/rendervulkan.hpp
@@ -878,7 +878,7 @@ public:
 	{
 		assert(size <= upload_buffer_size);
 
-		m_uploadBufferOffset = align(m_uploadBufferOffset, 16);
+		m_uploadBufferOffset = align(m_uploadBufferOffset, m_uUploadAlignment);
 		if (m_uploadBufferOffset + size > upload_buffer_size)
 		{
 			fprintf(stderr, "Exceeded uploadBufferData\n");
@@ -935,6 +935,7 @@ protected:
 
 	bool m_bSupportsFp16 = false;
 	uint32_t m_uVendorID = 0;
+	uint32_t m_uUploadAlignment = 16;
 	bool m_bHasDrmPrimaryDevId = false;
 	bool m_bSupportsModifiers = false;
 	bool m_bInitialized = false;
-- 
2.34.1

