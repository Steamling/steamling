# steamling-turnip-arm — pinned aarch64 Turnip builds, one per upstream series, that the per-game
# "Mesa Version" tweak selects by pointing VK_DRIVER_FILES at them (ARM Proton path).
# Counterpart of steamling-turnip-x86; same per-SoC tuning contract as packages/soc/mesa.
pkgname=steamling-turnip-arm
pkgver=20261025
pkgrel=1
pkgdesc="Pinned aarch64 Turnip builds for per-game Mesa selection (SoC-tuned)"
arch=('aarch64')
url="https://www.mesa3d.org/"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
depends=(expat glibc libdrm libdisplay-info libx11 libxcb libxshmfence spirv-tools
         systemd-libs vulkan-icd-loader wayland xcb-util-keysyms zlib zstd)
# glslang: newer mesa folds freedreno into the BVH shader set, so glslangValidator is a hard
# requirement of any build with vulkan-drivers=freedreno.
makedepends=(meson ninja python-mako python-packaging python-yaml python-ply glslang
             expat libdrm libglvnd libdisplay-info spirv-tools systemd-libs vulkan-icd-loader
             wayland wayland-protocols zlib zstd
             xorgproto libx11 libxcb libxext libxshmfence libxxf86vm libxrandr xcb-util-keysyms)
options=(!lto)
# Two entries build from a pinned commit rather than a release tarball, fetched as GitLab's
# commit-addressed archive: 26.3's release candidate (the newest Adreno 7xx fixes that have a
# release behind them) and a mesa main snapshot. Pinned, not floating, so rebuilds reproduce;
# refresh the commits deliberately. Their checksums are SKIP: the commit in the URL fixes the
# tree, and GitLab regenerates the archive, so its compressed bytes are not stable.
declare -gA _commits=(
  ['26.3.0rc2']=b34c71d9ff2f6514a1f947609d00e49be639edf8    # tag mesa-26.3.0-rc2
  ['27.0.0devel']=e7371b0711bb1cd38c39d1c05e5578c445cc6bca  # main, 2026-10-25
)
# The series mesa itself ships comes from its vk-arm payload; pinning mesa's pkgver here = file conflict.
_versions=('25.0.7' '25.1.9' '25.2.8' '25.3.6' '26.0.8' '26.1.6' '26.3.0rc2' '27.0.0devel')
source=('0001-c11-threads-fix-build-on-c23.patch'
        'https://archive.mesa3d.org/mesa-25.0.7.tar.xz'
        'https://archive.mesa3d.org/mesa-25.1.9.tar.xz'
        'https://archive.mesa3d.org/mesa-25.2.8.tar.xz'
        'https://archive.mesa3d.org/mesa-25.3.6.tar.xz'
        'https://archive.mesa3d.org/mesa-26.0.8.tar.xz'
        'https://archive.mesa3d.org/mesa-26.1.6.tar.xz'
        "https://gitlab.freedesktop.org/mesa/mesa/-/archive/${_commits[26.3.0rc2]}/mesa-${_commits[26.3.0rc2]}.tar.gz"
        "https://gitlab.freedesktop.org/mesa/mesa/-/archive/${_commits[27.0.0devel]}/mesa-${_commits[27.0.0devel]}.tar.gz")
sha256sums=('SKIP'
            '592272df3cf01e85e7db300c449df5061092574d099da275d19e97ef0510f8a6'
            '412df33a1bb3c785ed698555a3972118a37c458e7accf6ae53f4bb87b3db454a'
            '097842f3e49d996868b38688db87b006f7d4541e93ce86d2f341d8b3e7be7c93'
            '59217efeac3b64e7ced958324b9db7494f1e0741aeb22d780276514cc1b8f206'
            'caf1c0061a68e88dfa74967a7e780c0e85d65b6c4e334cd69095a5dc54ad78bc'
            '5296b88a0f1e012e2cb9ada150a2bbadf728ca81e5a4fb2ab43c83a4d2158606'
            'SKIP'
            'SKIP')

# A commit build extracts to mesa-<commit>, a release to mesa-<ver>; RC tarballs keep the hyphen
# that makepkg forbids in a version string, so our entries strip it and this restores it.
_srctag() {
  if [ -n "${_commits[$1]:-}" ]; then printf '%s' "${_commits[$1]}"
  else printf '%s' "${1/rc/-rc}"; fi
}

prepare() {
  # The c11-threads C23 fix is already in 26.x and some late 25.x point releases: dry-run first
  # and apply only where missing, because a reversed-patch prompt hangs the build.
  local v
  for v in "${_versions[@]}"; do
    cd "${srcdir}/mesa-$(_srctag "$v")"
    if patch -Np1 --forward --dry-run -i "${srcdir}/0001-c11-threads-fix-build-on-c23.patch" >/dev/null 2>&1; then
      patch -Np1 --forward -i "${srcdir}/0001-c11-threads-fix-build-on-c23.patch"
    fi
  done
}

build() {
  # Same tuning contract as packages/soc/mesa (sm8550 fallback for a standalone makepkg).
  local _rocknix_tune="${STEAMLING_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS="${CFLAGS} ${_rocknix_tune}"
  export CXXFLAGS="${CXXFLAGS} ${_rocknix_tune}"

  # Both WSI platforms stay on: x11 for XWayland games, wayland for gamescope-native ones.
  local _meson=(
    --prefix=/usr --buildtype=plain
    -Db_ndebug=true
    -Dplatforms=x11,wayland
    -Dglx=disabled
    -Degl=disabled
    -Dgbm=disabled
    -Dopengl=false
    -Dgles1=disabled
    -Dgles2=disabled
    -Dgallium-drivers=
    -Dvulkan-drivers=freedreno
    -Dfreedreno-kmds=msm
    -Dvulkan-layers=
    -Dllvm=disabled
    -Dshader-cache=enabled
    -Dandroid-libbacktrace=disabled
    -Dlibunwind=disabled
    -Dvalgrind=disabled
    -Dbuild-tests=false
  )
  # Turnip keys its shader cache on its build ID; derive it from the inputs (version, source
  # hash, tuning, options) so a rebuild of unchanged inputs keeps users' caches, on the series
  # whose meson.options has tu-build-id. Each series gets its own ID, so no two share a cache.
  local v i tu_args
  for i in "${!_versions[@]}"; do
    v="${_versions[$i]}"
    tu_args=()
    if grep -q "'tu-build-id'" "mesa-$(_srctag "$v")/meson.options" 2>/dev/null; then
      # A commit build's checksum is SKIP, so its commit stands in: a refreshed commit must get a
      # new ID, or games would load shaders cached by the previous driver.
      tu_args=(-Dtu-build-id="$(printf '%s\n' aarch64 "${_rocknix_tune}" "${v}" "${_commits[$v]:-${sha256sums[$((i + 1))]}}" "${_meson[*]}" \
        | sha256sum | cut -c1-40)")
    fi
    meson setup "build-${v}" "mesa-$(_srctag "$v")" "${_meson[@]}" "${tu_args[@]}"
    meson compile -C "build-${v}"
  done
}

package() {
  local v stage dir
  for v in "${_versions[@]}"; do
    stage="${srcdir}/stage-${v}"
    meson install -C "build-${v}" --destdir "${stage}" --no-rebuild
    dir="${pkgdir}/usr/share/steamling/vk-arm/${v}"
    install -Dm755 "${stage}/usr/lib/libvulkan_freedreno.so" "${dir}/libvulkan_freedreno.so"
    # ICD manifest name has varied across releases, hence the glob.
    sed -E "s|\"library_path\": *\"[^\"]*\"|\"library_path\": \"/usr/share/steamling/vk-arm/${v}/libvulkan_freedreno.so\"|" \
      "${stage}"/usr/share/vulkan/icd.d/freedreno_icd*.json > "${dir}/icd.json"
    chmod 0644 "${dir}/icd.json"
  done
  install -Dm644 "mesa-$(_srctag "${_versions[-1]}")/docs/license.rst" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
