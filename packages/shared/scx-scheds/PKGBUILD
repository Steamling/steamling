# scx-scheds - sched_ext schedulers; scx_lavd is the default CPU scheduler (steamling-lavd.service).
# Shadows the base's copy by repo order: a newer base scx never reaches devices while published.
pkgname=scx-scheds
pkgver=1.1.4
pkgrel=4
_commit=e7b3a219617472cf78880ac424714e52c932db61
_rustver=1.99.0
pkgdesc='sched_ext schedulers and tools'
arch=('aarch64')
url='https://github.com/sched-ext/scx'
license=('GPL-2.0-only')
depends=('bash' 'bpf' 'libgcc' 'glibc' 'jq' 'libseccomp' 'libbpf' 'libelf' 'protobuf' 'zlib')
makedepends=('clang' 'git' 'llvm' 'llvm-libs' 'python')
options=('!lto' '!debug')
source=("scx::git+https://github.com/sched-ext/scx.git#commit=${_commit}"
        "https://static.rust-lang.org/dist/rust-${_rustver}-aarch64-unknown-linux-gnu.tar.xz"
        '0006-scx_lavd-cap-the-load-balancing-band-by-the-other-domains-share.patch'
        '0007-scx_lavd-use-setters-for-the-remaining-slice-and-dsq_vtime-writes.patch'
        '0008-libbpf-add-128-bit-integer-types-to-linux-types.h.patch')
sha256sums=('SKIP'
            '5a30ce742be0835d9b23fc862db5cbbbc71464e1c9b1fca22917e10e4ba32a92'
            'SKIP'
            'SKIP'
            'SKIP')

_toolchain() {
  # libbpf-cargo and bindgen pipe every generated skeleton and binding through rustfmt. A
  # rustfmt that cannot run (a rustup proxy with no toolchain, a mismatched build) exits at once
  # and the build dies with "Failed to generate skeleton ... Broken pipe". Formatting changes
  # nothing the compiler sees, so a pass-through rustfmt stands in for it.
  # scx_cargo turns formatting off by naming a rustfmt that doesn't exist ("disable_rustfmt") and
  # counting on the spawn failing. Under qemu-user the spawn of a missing program "succeeds" and
  # the child dies straight away, so the same Broken pipe follows: give that name the shim too.
  mkdir -p "${srcdir}/shim"
  printf '#!/bin/sh\ncase "$1" in -V|--version) echo "rustfmt 1.8.0-stable"; exit 0 ;; esac\nexec cat\n' \
    > "${srcdir}/shim/rustfmt"
  chmod 755 "${srcdir}/shim/rustfmt"
  ln -sf rustfmt "${srcdir}/shim/disable_rustfmt"
  export PATH="${srcdir}/shim:${srcdir}/rust/bin:${PATH}"
  # Crate downloads cached beside the other sources so rebuilds stay offline.
  export CARGO_HOME="${SRCDEST:-${srcdir}}/cargo-home"
}

prepare() {
  "${srcdir}/rust-${_rustver}-aarch64-unknown-linux-gnu/install.sh" \
    --prefix="${srcdir}/rust" --disable-ldconfig \
    --components=rustc,cargo,rust-std-aarch64-unknown-linux-gnu >/dev/null
  _toolchain
  cd scx
  # Patch numbers are never reused; dropped ones are listed in PATCHES.md.
  local p
  for p in "${source[@]}"; do
    case "${p}" in 0008-*) ;; *.patch) patch -p1 < "${srcdir}/${p}" ;; esac   # 0008: below
  done
  cargo fetch --locked --target aarch64-unknown-linux-gnu
  # 0008 goes into the libbpf that libbpf-sys vendors, not scx: Linux 7.3's arm64 headers use
  # __u128, which libbpf 1.7's own linux/types.h doesn't define. The crate cache outlives a
  # build, so only patch a copy that hasn't been patched yet.
  local lb
  for lb in "${CARGO_HOME}"/registry/src/*/libbpf-sys-*/libbpf; do
    grep -q '__u128' "${lb}/include/linux/types.h" \
      || patch -d "${lb}" -p1 < "${srcdir}/0008-libbpf-add-128-bit-integer-types-to-linux-types.h.patch"
  done
}

build() {
  _toolchain
  cd scx
  # Same member set as the base's package, so this upgrade drops none of its binaries. The
  # experimental schedulers and the arena self-tests stay out.
  cargo build --release --frozen --workspace \
    --exclude scx_rlfifo --exclude scx_mitosis --exclude scx_characterize \
    --exclude xtask --exclude vmlinux_docify --exclude scx_arena_selftests \
    --exclude scx_arena_libarena_selftests --exclude scx_nitosis --exclude scx_mavd
}

package() {
  cd scx
  find target/release -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "${pkgdir}/usr/bin/" {} +
}
