[Unit]
Description=Rename legacy ROCKNIX-named internal boot partition to STEAMLING
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-remount-fs.service local-fs-pre.target
Before=flash.mount local-fs.target shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/steamling-internal-boot-rename
TimeoutStartSec=30
