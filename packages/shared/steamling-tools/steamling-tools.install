# PATH prefers /usr/local/bin, so a stale overlay copy would shadow the packaged
# fix on pre-package devices (#34). No-op on fresh images.
_prune_overlay_tools() {
  rm -f /usr/local/bin/steamling-installer-gui \
        /usr/local/bin/steamling-install-internal \
        /usr/local/bin/steamling-uninstall-internal \
        /usr/share/applications/steamling-installer.desktop
}

# The diagnostics dump and the root expansion were image overlay files too, with /etc units that
# shadow the packaged ones. An enable link the image made is repointed, so a pending expansion
# still runs.
_retire_overlay_firstboot() {
  local u wants=/etc/systemd/system/multi-user.target.wants
  rm -f /usr/local/bin/steamling-diag /usr/local/bin/steamling-expand-root
  for u in steamling-diag steamling-expand-root; do
    [ -e "/etc/systemd/system/${u}.service" ] || continue
    rm -f "/etc/systemd/system/${u}.service"
    [ -L "${wants}/${u}.service" ] && ln -sfn "/usr/lib/systemd/system/${u}.service" "${wants}/${u}.service"
  done
  [ -d /run/systemd/system ] && systemctl daemon-reload
  return 0
}

post_install() {
  _prune_overlay_tools
  _retire_overlay_firstboot
}

post_upgrade() {
  _prune_overlay_tools
  _retire_overlay_firstboot
}
