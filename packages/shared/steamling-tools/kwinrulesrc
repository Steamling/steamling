# Steamling Tools and the internal installer are kdialog windows, which KWin opens at their
# minimum size: too small to read on a handheld screen. Open them maximized instead ("apply
# initially", so they can still be resized). Matched by app and title, so other kdialogs are
# left alone. A user's own ~/.config/kwinrulesrc takes over this file's [General] list.
[General]
count=1
rules=steamling-tools-maximized

[steamling-tools-maximized]
Description=Steamling Tools opens maximized
wmclass=kdialog
wmclassmatch=2
wmclasscomplete=false
title=Steamling
titlematch=2
maximizehoriz=true
maximizehorizrule=3
maximizevert=true
maximizevertrule=3
