#!/bin/bash
# Stamps Steamling identity into /usr/lib/os-release (filesystem-owned, so the hook re-runs
# this after every filesystem upgrade). Steam's Settings > System reads VERSION_ID as
# "OS Version" and BUILD_ID as "OS Build". ID/ID_LIKE stay archarm/arch for tooling.
set -euo pipefail

# Bump at each image cut.
STEAMLING_VERSION=0.4.0

osr=/usr/lib/os-release
lock=/usr/share/steamling/steamling-base.lock
[ -f "${osr}" ] || exit 0

# The kernel package names the SoC family; the device tree would be the build host's in
# an image chroot.
soc="$(ls -d /var/lib/pacman/local/linux-steamling-sm*-[0-9]* 2>/dev/null | head -1 | sed -n 's|.*/linux-steamling-\(sm[0-9]*\)-.*|\1|p')"
base="$(sed -n 's/^#.*snapshot \([0-9][0-9.]*\).*/\1/p' "${lock}" 2>/dev/null | head -1)"

tmp="$(mktemp "${osr}.XXXXXX")"
trap 'rm -f "${tmp}"' EXIT
{
  echo 'NAME="Steamling OS"'
  echo 'PRETTY_NAME="Steamling OS"'
  echo "VERSION=\"${STEAMLING_VERSION}${base:+ (base ${base})}\""
  echo "VERSION_ID=${STEAMLING_VERSION}"
  echo "BUILD_ID=${base:-rolling}"
  [ -z "${soc}" ] || echo "VARIANT_ID=${soc}"
  echo 'HOME_URL="https://github.com/dvandenburgh/steamling"'
  echo 'BUG_REPORT_URL="https://github.com/dvandenburgh/steamling/issues"'
  grep -vE '^(NAME|PRETTY_NAME|VERSION|VERSION_ID|BUILD_ID|VARIANT_ID|HOME_URL|DOCUMENTATION_URL|SUPPORT_URL|BUG_REPORT_URL)=' "${osr}" || true
} > "${tmp}"
chmod 644 "${tmp}"
mv -f "${tmp}" "${osr}"
