// Passwordless pkexec of these two CLIs for wheel, same trust as 50-steamling-deck.rules.
// Shipped by the package so the authorization travels with the binaries it authorizes.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) { return; }
    if (action.id == "org.freedesktop.policykit.exec" &&
        (action.lookup("program") == "/usr/bin/steamling-update" ||
         action.lookup("program") == "/usr/bin/steamling-base")) {
        return polkit.Result.YES;
    }
});
