# filesystem upgrades restore Arch's os-release; base-lock upgrades change BUILD_ID; the
# kernel package names the SoC (VARIANT_ID).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = steamling-base-lock
Target = steamling-base
Target = linux-steamling-*

[Action]
Description = steamling: stamping os-release...
When = PostTransaction
Exec = /usr/lib/steamling/steamling-os-release
