# Fielded devices get post_install (a new name on -Syu). Never start the unit here: -Syu runs
# inside the live getty session, and Conflicts= would stop it.

_unit=/usr/lib/systemd/system/steamling-session.service
_dm=/etc/systemd/system/display-manager.service
_autologin=/etc/systemd/system/getty@tty1.service.d/autologin.conf
# sha256 of every version the image overlay shipped; a file matching none was edited, keep it.
_autologin_shipped="00aabb8d3f6d04e00dc67feda77066555ac367badff25be891a7366ddfcf6e36
6c6d790aea836ceb4dfa1f306be486f410a8b55e4f1db045b989d2c209a7ab16"
_profile_shipped="57ea48ad6d0c3507681ce249b3e53991dd7c66518379f915a6e3ca9dbeae7124
98bb25f0af470cdbabdbe2218c30a12dbb283429bd81269f96d158ccf59b476b
a28510f6609a7c26f48d12d3d8c75f19a2f5cfd29e58e1eabecd6d1737518cb4
f11f0f9c433d25a7a72e32e4ea8e61b087db896c5b1eb3e295254b3101f64428"

_shipped() {  # <file> <hashes>
  [ -f "$1" ] || return 1
  printf '%s\n' "$2" | grep -qx "$(sha256sum "$1" | cut -d' ' -f1)"
}

# The deck polkit rules were an image overlay file, and an /etc rules file shadows the packaged one
# of the same name. Only a copy the overlay shipped goes; an edited one is the admin's.
_rules=/etc/polkit-1/rules.d/50-steamling-deck.rules
_rules_shipped="04c269f5a6692aca3e73e7c59dac83c77a6ebd1e7bbe04f3551494951ca39b20
0e907c81015d66b9362331f859f49f026d389a1449506763c794192c09fe667d
327be8461c398755465e063b60e67395a88516280454fd43db1361f1f94c8edf
70fedc281d17cf28605a9e8c6c9addbd90429435acce252aaaf6c2deb2e880d3
7f1d6e20758e93150e196be6e141ae03b7799f7b9052249b1d731a328b11b5af
c11c5c5f00825ad2a94e2a611a6decb431c2f00264e5e8360a5c738aa185bef7"

_retire_overlay_rules() {
  _shipped "${_rules}" "${_rules_shipped}" && rm -f "${_rules}"
  return 0
}

post_install() {
  _retire_overlay_rules
  if [ -e "${_dm}" ] && [ "$(readlink -f "${_dm}")" != "${_unit}" ]; then
    echo ">>> steamling-session: ${_dm} belongs to another display manager, not enabling"
    return 0
  fi
  systemctl enable steamling-session.service >/dev/null 2>&1 || true

  if _shipped "${_autologin}" "${_autologin_shipped}"; then
    rm -f "${_autologin}"
    rmdir "${_autologin%/*}" 2>/dev/null || true
  fi
  local home
  home="$(getent passwd deck | cut -d: -f6)"
  if [ -n "${home}" ] && [ -f /etc/skel/.bash_profile ] \
     && _shipped "${home}/.bash_profile" "${_profile_shipped}"; then
    # New inode: a running shell may still be reading the old file.
    install -m644 -o deck -g deck /etc/skel/.bash_profile "${home}/.bash_profile.steamling-new" \
      && mv -f "${home}/.bash_profile.steamling-new" "${home}/.bash_profile"
  fi
}

post_upgrade() {
  _retire_overlay_rules
}

post_remove() {
  systemctl disable steamling-session.service >/dev/null 2>&1 || true
}
