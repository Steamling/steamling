# Living in alpm is what makes every update path (QAM, steamling-update, a plain -Syu
# over ssh) snapshot-protected. No AbortOnFail: a snapshot that fails or is skipped
# (ext4 install, build chroot, low disk space) must never block the update itself.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = steamling: pre-update btrfs snapshot...
When = PreTransaction
Exec = /usr/bin/steamling-snapshot-pre
NeedsTargets
