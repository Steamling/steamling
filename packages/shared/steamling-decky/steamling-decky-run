#!/bin/bash
# steamling-decky-run — launch Decky's PluginLoader. Decky ships a native arm64 build now,
# which runs as is. A loader that is still the x86_64 build (bundled before, or self-updated from
# it) runs under FEX instead: its onefile bootloader re-execs itself, so it needs the FEX binfmt
# handler registered even when the user has set steamling-fex-binfmt off, and binfmt_misc is
# userns-scoped, hence the private instance. CAP_CHOWN is still checked against the init userns,
# so chowning the seeded tree belongs in steamling-decky-sync.
set -eu

loader=/home/deck/homebrew/services/PluginLoader

# ELF e_machine, bytes 18-19: b7 00 = aarch64, 3e 00 = x86_64.
machine="$(od -An -tx1 -j18 -N2 "${loader}" 2>/dev/null | tr -d ' \n')"
if [ "${machine}" = b700 ]; then
  exec "${loader}"
fi

# slave, not unshare's default private: init-ns mounts still propagate IN, so plugin backends
# see live SD automounts instead of pinning a stale copy that keeps the device busy on format.
exec unshare --user --map-users=0,0,4294967295 --map-groups=0,0,4294967295 --mount --propagation slave \
  /bin/bash -c '
    set -eu
    mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
    grep -h . /usr/lib/binfmt.d/FEX-x86_64.conf > /proc/sys/fs/binfmt_misc/register
    grep -h . /usr/lib/binfmt.d/FEX-x86.conf    > /proc/sys/fs/binfmt_misc/register
    # /usr/bin/FEX, not FEXInterpreter: the deprecated alias no longer ships.
    exec /usr/bin/FEX "$1"
  ' bash "${loader}"
