[Unit]
Description=Decky Loader (via FEX)
# ExecStart must stay steamling-decky-run: it supplies the private binfmt_misc namespace the
# x86_64 loader needs. Rationale in that script.
# network.target, as upstream Decky's own unit has it: waiting for network-online pulled in
# NetworkManager-wait-online, which holds the loader (and Steamling Control) for up to a minute
# whenever a saved Wi-Fi network is out of range. Nothing the loader starts needs the network.
After=network.target steamling-decky-sync.service
Wants=steamling-decky-sync.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
WorkingDirectory=/home/deck/homebrew/services
ExecStart=/usr/lib/steamling/steamling-decky-run
Environment=PATH=/usr/lib/steamling/decky-bin:/usr/local/sbin:/usr/local/bin:/usr/bin
Environment=UNPRIVILEGED_PATH=/home/deck/homebrew
Environment=PRIVILEGED_PATH=/home/deck/homebrew
Environment=PLUGIN_PATH=/home/deck/homebrew/plugins
Environment=UNPRIVILEGED_USER=deck
Environment=KEEP_SYSTEMD_SERVICE=1
Environment=USE_CEF_CLOSE_WORKAROUND=0
Environment=LOG_LEVEL=INFO
Environment=FEX_APP_CONFIG=/usr/share/fex-emu/AppConfig/PluginLoader.json

[Install]
WantedBy=multi-user.target
