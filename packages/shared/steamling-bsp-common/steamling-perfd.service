[Unit]
Description=steamling power profiles (Steam's QAM performance controls)

[Service]
Type=dbus
BusName=org.steamling.Perf
ExecStart=/usr/lib/steamling/steamling-perfd
# Runs on every stop, crash included, so caps never outlive the daemon.
ExecStopPost=/usr/lib/steamling/steamling-perfd --reset-stock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
