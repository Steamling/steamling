[Unit]
Description=Re-assert the steamling session gamepad target
# InputPlumber always comes back on the YAML default; see steamling-gamepad-target.
After=inputplumber.service
BindsTo=inputplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/steamling-gamepad-target --apply

[Install]
WantedBy=inputplumber.service
