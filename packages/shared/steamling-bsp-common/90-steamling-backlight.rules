# Steam's brightness slider writes /sys/class/backlight/*/{brightness,bl_power}, root-owned by
# default, so it silently does nothing for the non-root deck session (which is in 'video').
# Not on a board with two screens (device.conf names the main one's STEAMLING_PANEL_BACKLIGHT):
# Steam adjusts the first backlight it finds, which can be the second screen's. Left read-only,
# Steam falls back to steamos-priv-write, which sends the write to the main panel.
ACTION!="add", GOTO="steamling_backlight_end"
SUBSYSTEM!="backlight", GOTO="steamling_backlight_end"
IMPORT{program}="/usr/lib/steamling/steamling-board-env"
ENV{STEAMLING_PANEL_BACKLIGHT}=="?*", GOTO="steamling_backlight_end"
RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power"
LABEL="steamling_backlight_end"
