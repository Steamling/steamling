# gamescope maps every touch device onto its single output, so a second screen's touchscreen
# (AYN Thor and Thor Lite) stays off libinput: until the second screen has its own session, its
# touches would land on the main panel. The Pocket DS's has its own rule in the SM8550 BSP.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="bottom_touchscreen", ENV{LIBINPUT_IGNORE_DEVICE}="1"
