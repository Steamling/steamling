# An idle Qualcomm DWC3 controller otherwise stays runtime-active and holds its 1 GB/s
# USB-to-DDR interconnect vote, which keeps DDR out of its low-power tiers. Runtime PM honours
# attached-device activity, so only an idle controller is autosuspended.
ACTION=="add|bind", SUBSYSTEM=="platform", KERNEL=="*.usb", DRIVERS=="dwc3-qcom", ATTR{power/control}="auto"
