#!/bin/sh
# Left untouched, the dwc3/type-c stack renegotiates on resume and holds dwc3+ufshcd resume
# ~10s each. TCPM/pmic_glink reverts the written value within ~300ms anyway - forcing the
# re-resolution is the operative part, so verify and re-assert once.
for r in /sys/class/usb_role/*-role-switch/role; do
  [ -f "$r" ] || continue
  mkdir -p /run/steamling
  cat "$r" > "/run/steamling/usb-role.$(basename "$(dirname "$r")")"
  echo none > "$r" 2>/dev/null || true
  sleep 0.3
  if [ "$(cat "$r")" != "none" ]; then
    echo "steamling-sleep: usb role reverted by typec stack; re-asserting" > /dev/kmsg
    echo none > "$r" 2>/dev/null || true
    sleep 0.2
    [ "$(cat "$r")" != "none" ] && \
      echo "steamling-sleep: usb role re-assert lost; suspending with role=$(cat "$r")" > /dev/kmsg
  fi
done
exit 0
