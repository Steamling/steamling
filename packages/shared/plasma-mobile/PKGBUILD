# plasma-mobile — the Plasma Mobile shell, built here against the libplasma we ship. Arch Linux
# ARM's copy can lag a Plasma release behind and link the previous libPlasma soname, so the shell
# can't load its own task panel and home screen, plasmashell crashes, and desktop mode stays black. Keep pkgver on the base's libplasma version: libplasma's
# soname has moved with each Plasma minor release, so the upper bound makes pacman refuse a newer
# libplasma this build can't load instead of installing it.
pkgname=plasma-mobile
pkgver=6.8.1
pkgrel=1.1
_commit=31477b8d72aba7df6ef13cb45548cea3d27ba696  # v6.8.1
pkgdesc='Plasma shell and components targeted for phones'
arch=('aarch64')
url='https://invent.kde.org/plasma/plasma-mobile'
license=('GPL-2.0-or-later')
depends=('gcc-libs' 'glibc'
         'kauth' 'kcmutils' 'kconfig' 'kcoreaddons' 'kdbusaddons' 'kglobalaccel' 'ki18n' 'kio'
         'kirigami' 'kirigami-addons' 'kitemmodels' 'kjobwidgets' 'knotifications' 'kpackage'
         'kpipewire' 'kservice' 'kwayland' 'kwin' 'kwindowsystem' 'layer-shell-qt' 'libepoxy'
         'libkscreen' "libplasma>=${pkgver}" "libplasma<${pkgver%.*}.90" 'libxcb' 'modemmanager-qt' 'networkmanager-qt'
         "plasma-activities>=${pkgver}" 'plasma-nano' "plasma-workspace>=${pkgver}" 'qcoro'
         'qt6-base' 'qt6-declarative' 'systemd-libs' 'wayland')
# vulkan-headers: Qt6Gui's CMake package looks for them (qt6-base is built with Vulkan) and,
# without them, reports Qt6Gui as not found, so Qt6Quick and everything after it fails to configure.
makedepends=('extra-cmake-modules' 'git' 'plasma-wayland-protocols' 'vulkan-headers')
optdepends=('plasma-settings: the settings app the mobile shell opens')
source=("plasma-mobile::git+https://github.com/KDE/plasma-mobile.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cmake -B build -S plasma-mobile \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
