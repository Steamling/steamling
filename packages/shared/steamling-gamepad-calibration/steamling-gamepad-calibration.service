[Unit]
Description=Restore the saved steamling gamepad calibration
After=systemd-modules-load.service
# InputPlumber reads the pad's axis ranges when it claims the device, so the
# driver has to be calibrated before it starts.
Before=inputplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/steamling-gamepad-calibration-restore

[Install]
WantedBy=multi-user.target
