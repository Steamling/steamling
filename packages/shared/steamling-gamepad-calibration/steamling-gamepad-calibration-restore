#!/bin/bash
# The driver comes back at its compiled-in defaults every boot; replay the save.
set -u

CONF=/etc/steamling/gamepad-calibration.conf
# Probe-time values for Governor's Reset; per board (devicetree overrides at probe).
DEFAULTS=/run/steamling/gamepad-calibration.defaults

# A gamepad driver built as a module loads on device probe, so the parameters can appear
# after this unit is ordered to run.
params=""
for _ in $(seq 1 50); do
  for candidate in /sys/module/*/parameters; do
    [ -e "${candidate}/axis_leftx_max" ] && [ -e "${candidate}/update_params" ] || continue
    params="${candidate}"
    break
  done
  [ -n "${params}" ] && break
  sleep 0.2
done

if [ -z "${params}" ]; then
  echo "no calibratable gamepad driver found, calibration not applied" >&2
  exit 0
fi

# Only once per boot: a unit restart after a replay must not snapshot calibrated values.
if [ ! -e "${DEFAULTS}" ]; then
  mkdir -p "${DEFAULTS%/*}"
  for f in "${params}"/axis_*_* "${params}"/trigger_*_*; do
    case "${f##*/}" in
      *_max|*_min|*_center|*_deadzone|*_antideadzone) printf '%s=%s\n' "${f##*/}" "$(cat "${f}")" ;;
    esac
  done > "${DEFAULTS}.tmp" && mv "${DEFAULTS}.tmp" "${DEFAULTS}"
fi

applied=0
[ -r "${CONF}" ] && while IFS='=' read -r key value; do
  key="${key%%[[:space:]]*}"
  value="${value%%[[:space:]]*}"
  # Plain parameter names only: a key with a path in it would write anywhere root can.
  case "${key}" in
    ''|'#'*) continue ;;
    *[!a-z0-9_]*) echo "ignoring malformed key ${key}" >&2; continue ;;
  esac
  [ -w "${params}/${key}" ] || { echo "unknown parameter ${key}, skipped" >&2; continue; }
  if printf '%s' "${value}" > "${params}/${key}"; then
    applied=1
  else
    echo "failed to write ${key}" >&2
  fi
done < "${CONF}"

# Governor's stick response: percentages of the calibrated values (or the boot-time
# defaults), the same maths as its tuning.py. Scaled from those, never from the live value, so a
# second run can't compound it.
TUNING=/etc/steamling/gamepad-tuning.conf
value_in() {  # <file> <key>
  sed -n "s/^$2=\(-\{0,1\}[0-9][0-9]*\)[[:space:]]*$/\1/p" "$1" 2>/dev/null | tail -n 1
}
base_of() {
  local v
  v="$(value_in "${CONF}" "$1")"
  [ -n "${v}" ] || v="$(value_in "${DEFAULTS}" "$1")"
  printf '%s' "${v}"
}
if [ -r "${TUNING}" ]; then
  for stick in left right; do
    dz="$(value_in "${TUNING}" "${stick}_deadzone")"
    outer="$(value_in "${TUNING}" "${stick}_outer")"
    case "${dz}" in 50|75|100|150|200|300) ;; *) dz=100 ;; esac
    case "${outer}" in 100|95|90|85|80) ;; *) outer=100 ;; esac
    [ "${dz}" = 100 ] && [ "${outer}" = 100 ] && continue
    for axis in "axis_${stick}x" "axis_${stick}y"; do
      for pair in "deadzone:${dz}" "antideadzone:${dz}" "max:${outer}" "min:${outer}"; do
        key="${axis}_${pair%%:*}"
        base="$(base_of "${key}")"
        [ -n "${base}" ] && [ -w "${params}/${key}" ] || continue
        printf '%s' "$(( base * ${pair##*:} / 100 ))" > "${params}/${key}" && applied=1
      done
    done
  done
fi

# The driver only picks up the new values when told to re-read them.
[ "${applied}" = "1" ] && printf '1' > "${params}/update_params"
exit 0
