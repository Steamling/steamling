# steamling-device-sm8550 — metapackage: the per-SoC members of a Retroid Pocket 6 system
# (BSP, kernel, bootloader, the proton choice). Shared members live on
# steamling-core / the steamling-*-full layers: a dep edge from here would block
# `pacman -Rs` of an optional layer.
# Successor to the retired per-device metapackages; 'replaces' migrates
# installed devices (e.g. an internal-installed RP6) on their next pacman -Syu.
pkgname=steamling-device-sm8550
pkgver=0.2.0
pkgrel=11.1
pkgdesc="steamling device metapackage: Retroid Pocket 6 (SM8550)"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
depends=('steamling-bsp-sm8550'
         'linux-steamling-sm8550'
         'steamling-bootloader-sm8550'
         # a7xx runs DXVK 3: the stock ARM protons
         'proton-cachyos'
         'proton-ge')
# Exactly one device metapackage per install (wrong-device guard, same pattern
# as the BSPs).
provides=('steamling-device')
conflicts=('steamling-device')
replaces=('steamling-device-rp6')

package() {
  :   # pure metapackage
}
